QLOO_API_KEY=            # hackathon key (required for live data)
QLOO_BASE=https://hackathon.api.qloo.com
QLOO_FIXTURES=0          # 1 = force offline fixtures (dev/tests)
QLOO_CONCURRENCY=4
LLM_MODEL=               # e.g. anthropic:claude-sonnet-5-5 ; blank = auto from keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MEM0_API_KEY=            # optional
RESEND_API_KEY=          # optional; without it emails are queued in the outbox
MAIL_FROM=Convivium <agent@yourdomain>
WEBHOOK_URL=             # optional Slack/Discord webhook
CONVIVIUM_DB=convivium.db
WATCH_INTERVAL_SECONDS=900
WATCHER_ENABLED=1
SEED_DEMO=1
PUBLIC_URL=http://localhost:8000
MAP_TILE_URL=            # optional Leaflet tile template, e.g. CARTO dark_all with your key; blank = OSM darkened
MAP_TILE_ATTRIBUTION=
